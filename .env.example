# Base URL of the EscuelaJS API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.escuelajs.co/api/v1

# OPTIONAL, DEVELOPMENT ONLY. Comma-separated emails that may open /admin even if the
# API account has no "admin" role. NEXT_PUBLIC_* values are visible to every visitor,
# so this is NOT security. See README -> "Admin authorization".
NEXT_PUBLIC_DEV_ADMIN_EMAILS=
